  },
  "folderUID": "dnceng",
  "ruleGroup": "DotNetEng Status Webhook Alerts",
  "intervalMs": 60000,
  "isPaused": false,
  "notification_settings": {
    "receiver": "Teams Alert",
    "group_wait": "5m",
    "repeat_interval": "4h"
  }
}
